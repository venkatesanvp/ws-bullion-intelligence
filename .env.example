POSTGRES_USER=bullion
POSTGRES_DB=bullion
POSTGRES_PASSWORD=GENERATE_LOCALLY
LOCAL_APP_TOKEN=GENERATE_LOCALLY
DATABASE_URL=postgresql+psycopg://bullion:GENERATE_LOCALLY@db:5432/bullion

