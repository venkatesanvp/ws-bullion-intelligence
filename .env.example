# Copy via: python scripts/configure_local.py (generates real local secrets).
# This file contains placeholders, not usable credentials.
POSTGRES_USER=bullion
POSTGRES_DB=bullion
POSTGRES_PASSWORD=GENERATE_LOCALLY
LOCAL_APP_TOKEN=GENERATE_LOCALLY
DATABASE_URL=postgresql+psycopg://bullion:GENERATE_LOCALLY@db:5432/bullion

# DhanHQ Developer Application
DHAN_APP_NAME=
DHAN_API_KEY=
DHAN_API_SECRET=

# Optional runtime credentials
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# DhanHQ API settings
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_DATA_API_ENABLED=false

# Step 5D.4 standing read-only retrieval (API only). No trading permissions.
# Enable locally to allow Apply range to acquire missing observations.
MARKET_DATA_ENABLED=false
MARKET_DATA_AUTO_MISSING=true
MARKET_DATA_MAX_REQUESTS=8
MARKET_DATA_PARTITION_DAYS=366
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_FRESHNESS_SECONDS=604800
MARKET_DATA_EMPTY_RETRY_SECONDS=3600
MARKET_DATA_FAILURE_BACKOFF_SECONDS=300
MARKET_DATA_MIN_INTERVAL_SECONDS=1
MARKET_DATA_DAILY_BUDGET=1000
MARKET_DATA_MAX_ROWS=100000
MARKET_DATA_MAX_COVERAGE_DAYS=100000
# Active-view polling: 0 disables; otherwise >=60 seconds. No background scheduler.
MARKET_DATA_AUTO_REFRESH_SECONDS=0

# Step 5E P0: read-only snapshots and intraday analytics (backend only)
MARKET_QUOTES_ENABLED=false
MARKET_INTRADAY_ENABLED=false
MARKET_QUOTE_REFRESH_SECONDS=15
MARKET_QUOTE_STALE_SECONDS=45
MARKET_INTRADAY_REFRESH_SECONDS=60
MARKET_INTRADAY_PARTITION_DAYS=7
MARKET_SESSION_MAX_REQUESTS=8
MARKET_SESSION_MAX_ROWS=100000
MARKET_PROVIDER_DAILY_BUDGET=10000

# Backend-only shared read-only WebSocket feed; disabled until locally enabled.
MARKET_STREAM_ENABLED=false
